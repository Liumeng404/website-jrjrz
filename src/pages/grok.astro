---
/**
 * SuperGrok 充值业务暂时维护下线。
 * 保留路由避免外链 404，页面 noindex，引导至在售服务。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SuperGrok 服务维护中 | 露梦AI Store"
  description="SuperGrok 代充业务暂时维护，暂停接单。当前可开通 ChatGPT Plus / Pro、Claude Pro 等服务。"
  keywords="SuperGrok维护,Grok充值"
  robots="noindex, follow"
>
  <nav class="sub-nav">
    <div class="nav-inner">
      <div class="sub-title">服务维护</div>
      <div class="sub-actions">
        <a href="/chatgpt/">ChatGPT</a>
        <a href="/claude/">Claude</a>
        <a class="pill small" href="javascript:void(0)" onclick="openQrModal()">联系客服</a>
      </div>
    </div>
  </nav>

  <main>
    <section class="section-pad">
      <div class="container" style="max-width:720px;text-align:center;">
        <div class="page-head" style="margin-bottom:28px;">
          <h1><span class="gradient-text">SuperGrok</span> 服务维护中</h1>
          <p style="margin-top:16px;line-height:1.7;color:var(--muted, #64748b);">
            SuperGrok（Grok 会员）代充业务<strong>暂时维护，暂停接单</strong>。
            恢复时间以本站公告为准，给您带来不便敬请谅解。
          </p>
        </div>

        <div
          class="prose"
          style="text-align:left;background:var(--soft, #f8fafc);border:1px solid var(--hairline, #e2e8f0);border-radius:16px;padding:24px 28px;margin:0 auto 32px;"
        >
          <p style="margin:0 0 12px;"><strong>当前可正常办理：</strong></p>
          <ul style="margin:0;padding-left:1.2em;line-height:1.8;">
            <li><a href="/chatgpt/">ChatGPT Plus / Pro 代充</a></li>
            <li><a href="/claude/">Claude Pro 代充</a></li>
          </ul>
          <p style="margin:16px 0 0;line-height:1.7;">
            若您此前已有 SuperGrok 相关订单咨询，请通过本站公示客服渠道联系，我们会按约定协助处理。
          </p>
        </div>

        <div class="hero-btns" style="justify-content:center;flex-wrap:wrap;gap:12px;">
          <a class="pill" href="/chatgpt/">ChatGPT 充值</a>
          <a class="pill secondary" href="/claude/">Claude 充值</a>
          <button class="pill secondary" type="button" onclick="openQrModal()">联系客服</button>
        </div>

        <p style="margin-top:28px;">
          <a href="/" style="color:inherit;opacity:0.75;">← 返回首页</a>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
