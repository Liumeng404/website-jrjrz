---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import HomeNav from '../components/HomeNav.astro';
import { getCollection } from 'astro:content';
import { getShopUrl, loadSiteConfig } from '../lib/site-config';
import { loadPrices } from '../lib/prices';

// 统一产品数据：public/prices.json（Decap「站点配置 → 套餐价格」可改）
const prices = loadPrices();
const pay = prices.payment;
const policy = prices.policy;

const siteConfig = loadSiteConfig();
const homeTdk = siteConfig.tdk.home;
const shopUrl = getShopUrl(siteConfig);

// 获取最新 3 篇文章用于首页展示
const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={homeTdk.title}
  description={homeTdk.description}
  keywords={homeTdk.keywords}
>
  <HomeNav slot="navigation" shopUrl={shopUrl} />

  <main class="home-main">
    <!-- ========== Hero ========== -->
    <section class="hero home-hero" id="home">
      <div class="hero-inner">
        <div class="home-brand-note"><span class="online-dot" aria-hidden="true"></span><strong>露梦AI Store</strong><span class="note-divider" aria-hidden="true">·</span><span>原账号充值服务</span></div>
        <h1><span class="hero-title-line">ChatGPT Plus <span class="hero-title-phrase">充值与代充</span></span><span class="hero-title-line hero-title-accent">Codex <span class="hero-title-phrase">充值与代充</span></span></h1>
        <p class="hero-desc">让 AI 订阅更简单，专注你想做的事</p>
        <p class="hero-support"><strong>ChatGPT / Codex · Claude · Grok</strong><span>原账号开通 · 无需账号密码 · {policy.refund}</span></p>
        <div class="hero-payment"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M3 10h18M7 15h4" /></svg><span>无需海外信用卡，支持 <strong>{pay.label}</strong></span></div>
        <div class="hero-btns">
          <a href={shopUrl} class="pill">进店更多选择 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></a>
          <a href="#services" class="pill secondary">查看套餐</a>
        </div>
        <ul class="hero-assurances" aria-label="服务保障">
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="3" /><path d="m8 12 3 3 5-6" /></svg>原账号开通</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 10-13h-7l1-7Z" /></svg>人工客服协助</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z" /><path d="m8 12 3 3 5-6" /></svg>失败全额退款</li>
        </ul>
        <section class="hero-contact" id="customer-service" aria-labelledby="hero-contact-title">
          <h2 id="hero-contact-title">有任何问题，欢迎添加客服咨询</h2>
          <dl class="hero-contact-list">
            <div class="hero-contact-row">
              <img class="contact-logo" src="/images/wechat.svg" alt="" width="20" height="20" />
              <div><dt>24小时在线客服微信</dt><dd>AILM_998</dd></div>
              <button type="button" class="contact-copy" data-copy="AILM_998" aria-label="复制客服微信号 AILM_998">复制</button>
            </div>
            <div class="hero-contact-row">
              <img class="contact-logo" src="/images/wechat.svg" alt="" width="20" height="20" />
              <div><dt>如添加频繁，可加备用微信</dt><dd>AILM_994</dd></div>
              <button type="button" class="contact-copy" data-copy="AILM_994" aria-label="复制备用微信号 AILM_994">复制</button>
            </div>
            <div class="hero-contact-row">
              <img class="contact-logo" src="/images/qq.svg" alt="" width="20" height="20" />
              <div><dt>也可以通过 QQ 联系我们</dt><dd>642099232</dd></div>
              <button type="button" class="contact-copy" data-copy="642099232" aria-label="复制客服 QQ 号 642099232">复制</button>
            </div>
          </dl>
          <p class="contact-copy-status" role="status" aria-live="polite"></p>
        </section>
      </div>
    </section>

    <!-- ========== 服务 ========== -->
    <section class="section-pad" id="services">
      <div class="container">
        <div class="services-header reveal">
          <div class="section-label">我们的服务</div>
          <h2 class="section-title">覆盖<span class="gradient-text">主流 AI 平台</span></h2>
          <p class="section-sub">原账号开通，账号安全有保障，拒绝共享账号风险。</p>
        </div>

        <div class="trust-strip reveal" style="--delay: 80ms;">
          <div class="trust-strip-inner">
            <div class="ts-verified"><span>✓</span><span>正规代充服务</span></div>
            <div class="ts-sep"></div>
            <div class="ts-item"><span class="ts-check">✓</span><span><strong>原账号开通</strong>，非共享账号</span></div>
            <div class="ts-sep"></div>
            <div class="ts-item"><span class="ts-check">✓</span><span><strong>无需账号密码</strong>，流程透明</span></div>
            <div class="ts-sep"></div>
            <div class="ts-item"><span class="ts-check">✓</span><span><strong>{pay.label}</strong>，人民币结算</span></div>
            <div class="ts-sep"></div>
            <div class="ts-item"><span class="ts-check">✓</span><span><strong>{policy.refund}</strong></span></div>
          </div>
        </div>

        <div class="cards-grid">
          <!-- ChatGPT Plus -->
          <article class="service-card reveal" style="--delay: 120ms;">
            <div class="card-recommend">主推 · ChatGPT</div>
            <div class="platform-logo openai" aria-label="OpenAI">
              <img src="/images/openai.svg" alt="OpenAI Logo" />
            </div>
            <div class="card-title">ChatGPT Plus</div>
            <p class="card-desc">解锁 GPT 最新模型、推理能力、联网搜索、图像生成与高级数据分析，适合日常 AI 工作流。</p>
            <ul class="card-features">
              <li>GPT 最新模型全系访问</li>
              <li>Codex AI Coding</li>
              <li>支持常用 AI 编程工作流</li>
              <li>实时联网与文件上传</li>
              <li>充到您的原账号</li>
              <li>支持企业服务咨询</li>
            </ul>
            <div class="card-warning"><span class="card-warning-icon">i</span><span>使用范围最广，新手首选，覆盖写作、搜索、代码和资料处理。</span></div>
            <div class="card-price"><span class="price-from">起步价</span><span class="price-num">¥{prices.chatgpt.plus}</span><span class="price-unit">/ 月</span></div>
            <a class="card-btn" href="/chatgpt/">选择方案</a>
          </article>

          <!-- Claude Pro -->
          <article class="service-card reveal" style="--delay: 200ms;">
            <div class="card-recommend">主推 · Claude</div>
            <div class="platform-logo claude" aria-label="Claude">
              <img src="/images/claude-color.svg" alt="Claude Logo" />
            </div>
            <div class="card-title">Claude Pro</div>
            <p class="card-desc">Anthropic 高阶模型，适合长文档、代码生成、论文整理与深度写作，比普通问答更偏专业工作。</p>
            <ul class="card-features">
              <li>Claude 高阶模型能力</li>
              <li>超长上下文窗口</li>
              <li>Projects 项目管理功能</li>
              <li>优先访问新功能</li>
              <li>充到您的原账号</li>
              <li>支持企业服务咨询</li>
            </ul>
            <div class="card-warning"><span class="card-warning-icon">!</span><span>Claude 风控较严格，使用时建议保持稳定网络环境。</span></div>
            <div class="card-price"><span class="price-from">起步价</span><span class="price-num">¥{prices.claude.pro}</span><span class="price-unit">/ 月</span></div>
            <a class="card-btn" href="/claude/">选择方案</a>
          </article>

          <!-- SuperGrok -->
          <article class="service-card service-card-extra reveal" style="--delay: 280ms;">
            <div class="platform-logo grok" aria-label="Grok">
              <img src="/images/grok.svg" alt="Grok Logo" />
            </div>
            <div class="card-title">SuperGrok</div>
            <p class="card-desc">适合关注实时信息、创意问答和日常研究的用户，直充您的自用账号，无需处理境外支付。</p>
            <ul class="card-features">
              <li>SuperGrok 会员权益</li>
              <li>原账号直充，账号归属不变</li>
              <li>支持{pay.label}</li>
              <li>无需提供账号密码</li>
              <li>当前提供月付方案</li>
              <li>人工客服协助处理</li>
            </ul>
            <div class="card-warning"><span class="card-warning-icon">i</span><span>当前仅月付 ¥{prices.grok.monthly}/月，直充自用账号，不提供共享号。</span></div>
            <div class="card-price"><span class="price-from">月付</span><span class="price-num">¥{prices.grok.monthly}</span><span class="price-unit">/ 月</span></div>
            <a class="card-btn" href="/grok/">选择方案</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== 充值流程（与二维码弹窗左侧购买流程一致） ========== -->
    <section class="section-pad section-dark" id="how">
      <div class="container">
        <div class="how-grid">
          <div class="reveal">
            <div class="section-label" style="text-align:left;">购买须知</div>
            <h2 class="section-title" style="text-align:left;">怎么<span class="gradient-text">购买</span></h2>
            <p class="section-sub" style="text-align:left;margin:0;">
              本站展示价格与套餐，<strong style="color:#fff;">下单在微信完成</strong>。先确认再付款，避免付错套餐。
            </p>
            <div class="steps">
              <article class="step reveal" style="--delay: 80ms;">
                <div class="step-num">01</div>
                <div class="step-content">
                  <div class="step-title">添加客服微信</div>
                  <p class="step-desc">用手机微信扫描下方二维码，备注想开的套餐。</p>
                  <div class="how-qr">
                    <img
                      class="how-qr-image"
                      src="/images/qrcode.png"
                      alt="客服微信二维码"
                      width="168"
                      height="168"
                    />
                    <p class="how-qr-hint">微信扫一扫 · 备注套餐更快处理</p>
                  </div>
                  <div class="step-tips">
                    <div class="step-tip"><span class="tip-dot"></span><span>正规代充不会索要您的账号密码。</span></div>
                  </div>
                </div>
              </article>
              <article class="step reveal" style="--delay: 160ms;">
                <div class="step-num">02</div>
                <div class="step-content">
                  <div class="step-title">说明你的需求</div>
                  <p class="step-desc">告诉客服：套餐名称、账号是否已有会员。我们先确认能否开通。</p>
                  <div class="step-tips">
                    <div class="step-tip"><span class="tip-dot"></span><span>先确认再付款，减少充错套餐和重复订阅。</span></div>
                  </div>
                </div>
              </article>
              <article class="step reveal" style="--delay: 240ms;">
                <div class="step-num">03</div>
                <div class="step-content">
                  <div class="step-title">确认后微信支付</div>
                  <p class="step-desc">价格与网站一致。确认无误后再付款，开通到你本人账号。</p>
                  <div class="step-tips">
                    <div class="step-tip"><span class="tip-dot"></span><span>付款后保留沟通记录，便于核验与售后。</span></div>
                  </div>
                </div>
              </article>
            </div>
          </div>

          <aside class="how-visual reveal" style="--delay: 220ms;">
            <div class="timeline-title">购买进度示意</div>
            <div class="how-timeline">
              <div class="how-tl-item">
                <div class="tl-icon">1</div>
                <div>
                  <div class="tl-label">添加客服微信</div>
                  <div class="tl-sub">扫码添加，备注想开的套餐</div>
                  <span class="tl-badge">微信扫码</span>
                </div>
              </div>
              <div class="how-tl-item">
                <div class="tl-icon">2</div>
                <div>
                  <div class="tl-label">说明你的需求</div>
                  <div class="tl-sub">套餐名称、账号是否已有会员</div>
                  <span class="tl-badge">先确认</span>
                </div>
              </div>
              <div class="how-tl-item">
                <div class="tl-icon">3</div>
                <div>
                  <div class="tl-label">确认后微信支付</div>
                  <div class="tl-sub">价格与网站一致，确认无误再付款</div>
                  <span class="tl-badge">{pay.label}</span>
                </div>
              </div>
              <div class="how-tl-item">
                <div class="tl-icon">✓</div>
                <div>
                  <div class="tl-label">开通完成</div>
                  <div class="tl-sub">权益开到你本人账号，登录验收即可</div>
                  <span class="tl-badge">本人账号</span>
                </div>
              </div>
            </div>
            <div class="timeline-chips">
              <span>1 对 1 跟进</span>
              <span>无需密码</span>
              <span>本人账号开通</span>
              <span>失败按规则退</span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ========== 为什么选择我们 ========== -->
    <section class="section-pad" id="benefits">
      <div class="container">
        <div class="section-label reveal">为什么选择我们</div>
        <h2 class="section-title reveal">安全 · <span class="gradient-text">快速</span> · 透明</h2>
        <div class="trust-grid" style="margin-top:44px;">
          <article class="trust-item reveal" style="--delay: 60ms;"><div class="trust-icon">01</div><div class="trust-title">账号安全有保障</div><p class="trust-desc">充值到您的原账号，无需共享密码，不影响账号归属。</p></article>
          <article class="trust-item reveal" style="--delay: 120ms;"><div class="trust-icon">02</div><div class="trust-title">极速到账</div><p class="trust-desc">ChatGPT Plus 自助流程最快 30 秒完成，其他服务按账号状态跟进。</p></article>
          <article class="trust-item reveal" style="--delay: 180ms;"><div class="trust-icon">03</div><div class="trust-title">便捷支付</div><p class="trust-desc">支持{pay.label}，无需境外信用卡，人民币结算更省心。</p></article>
          <article class="trust-item reveal" style="--delay: 240ms;"><div class="trust-icon">04</div><div class="trust-title">原账号订阅</div><p class="trust-desc">不提供共享账号，减少隐私泄露和多人共用带来的风险。</p></article>
          <article class="trust-item reveal" style="--delay: 300ms;"><div class="trust-icon">05</div><div class="trust-title">售后有保障</div><p class="trust-desc">提供必要的技术支持，充值失败按约定全额退款。详见 <a href="/refund/">退款与售后政策</a>。</p></article>
          <article class="trust-item reveal" style="--delay: 360ms;"><div class="trust-icon">06</div><div class="trust-title">企业服务咨询</div><p class="trust-desc">支持企业批量采购、对账资料和周期续费需求沟通。</p></article>
        </div>
      </div>
    </section>

    <!-- ========== FAQ ========== -->
    <section class="section-pad section-soft" id="faq">
      <div class="container">
        <div class="section-label reveal">常见问题</div>
        <h2 class="section-title reveal">您可能<span class="gradient-text">想知道</span></h2>
        <div class="faq-list" style="margin-top:44px;">
          <div class="faq-item active"><div class="faq-q">国内怎么订阅 ChatGPT Plus？没有信用卡怎么开通？<span class="faq-icon">+</span></div><div class="faq-a">国内用户可以通过代充服务完成 ChatGPT Plus 订阅。您只需完成{pay.label}付款，并按流程提交必要信息，无需境外信用卡，也无需提供账号密码。</div></div>
          <div class="faq-item"><div class="faq-q">Claude Pro 国内怎么订阅？大陆可以充值吗？<span class="faq-icon">+</span></div><div class="faq-a">Claude Pro 会根据账号状态、地区和使用环境确认是否适合开通。付款前建议先联系客服核对，避免因平台风控导致无法交付。</div></div>
          <div class="faq-item"><div class="faq-q">Claude 和 ChatGPT 哪个好？应该选哪个？<span class="faq-icon">+</span></div><div class="faq-a">ChatGPT Plus 更适合通用问答、搜索、图像生成和编程辅助；Claude Pro 更适合长文档、学术写作、代码审阅和复杂文本处理。</div></div>
          <div class="faq-item"><div class="faq-q">ChatGPT Plus 和 Claude Pro 一个月多少钱？<span class="faq-icon">+</span></div><div class="faq-a">ChatGPT Plus 当前月付价格为 ¥{prices.chatgpt.plus}，Claude Pro 当前月付价格为 ¥{prices.claude.pro}。您可以按主要使用场景选择更适合的方案。</div></div>
          <div class="faq-item"><div class="faq-q">订阅失败怎么办？充值后多久到账？<span class="faq-icon">+</span></div><div class="faq-a">ChatGPT Plus 自助充值一般很快完成；Claude 与 SuperGrok 会根据账号状态确认交付时间。如因账号或平台限制无法完成，未成功部分按约定退款。</div></div>
          <div class="faq-item"><div class="faq-q">SuperGrok 怎么买？一个月多少钱？<span class="faq-icon">+</span></div><div class="faq-a">SuperGrok 当前提供月付方案，价格为 ¥{prices.grok.monthly}/月，直充自用账号。详情见 <a href="/grok/">SuperGrok 服务页</a>。</div></div>
          <div class="faq-item"><div class="faq-q">支持哪些付款方式？<span class="faq-icon">+</span></div><div class="faq-a">{pay.faq}</div></div>
        </div>
      </div>
    </section>

    <!-- ========== 最新文章（SEO 内容板块） ========== -->
    {latestPosts.length > 0 && (
      <section class="section-pad">
        <div class="container">
          <div class="latest-articles-header reveal">
            <div class="section-label">博客 · 教程与资讯</div>
            <h2 class="section-title">最新<span class="gradient-text">文章</span></h2>
            <p class="section-sub">AI 工具使用教程、行业资讯与技术分享，帮你更好地使用 AI。</p>
          </div>
          <div class="blog-grid reveal" style="--delay: 100ms;">
            {latestPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.id}/`}
                pubDate={post.data.pubDate}
                image={post.data.image}
                tags={post.data.tags}
                author={post.data.author}
              />
            ))}
          </div>
          <div class="latest-articles-more reveal" style="--delay: 200ms;">
            <a class="pill secondary" href="/blog/">查看全部文章 →</a>
          </div>
        </div>
      </section>
    )}

    <!-- ========== CTA ========== -->
    <section class="cta-banner" id="contact">
      <div class="container">
        <div class="section-label">立即开始</div>
        <h2 class="section-title">解锁你的 <span class="gradient-text">AI 全能助手</span></h2>
        <p class="section-sub">添加客服微信确认账号状态与套餐，确认后再付款开通。</p>
        <div class="hero-btns" style="margin-top:38px;margin-bottom:0;">
          <button class="pill" type="button" onclick="openQrModal()">添加微信</button>
          <a class="pill secondary" href="#services">查看套餐</a>
        </div>
        <div class="cta-points"><span>✓ 无需注册</span><span>✓ {pay.ctaPoint}</span><span>✓ {policy.refund}</span></div>
      </div>
    </section>
  </main>
  <button class="floating-wechat" type="button" data-copy="AILM_998" aria-label="复制客服微信号 AILM_998" title="点击复制客服微信号">
    <img class="floating-brand" src="/images/logo.jpg" width="34" height="34" alt="" />
    <span class="floating-contact-text"><small>微信咨询</small><strong>AILM_998</strong></span>
    <span class="floating-copy-action"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></svg><span>复制</span></span>
  </button>
  <div class="home-copy-toast" role="status" aria-live="polite"></div>
</BaseLayout>

<script>
  const toast = document.querySelector<HTMLElement>('.home-copy-toast');
  const floatingWechat = document.querySelector<HTMLElement>('.floating-wechat');
  const inlineContact = document.querySelector<HTMLElement>('.hero-contact');
  if (inlineContact && floatingWechat && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      floatingWechat.classList.toggle('has-inline-contact', entry.isIntersecting);
    }).observe(inlineContact);
  }
  let toastTimer: ReturnType<typeof setTimeout>;
  document.querySelectorAll<HTMLButtonElement>('.contact-copy, .floating-wechat').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.dataset.copy;
      const status = document.querySelector<HTMLElement>('.contact-copy-status');
      if (!value || !status || !toast) return;
      let message: string;
      try {
        await navigator.clipboard.writeText(value);
        message = `已复制 ${value}，可粘贴到微信或 QQ 搜索添加。`;
      } catch {
        message = `自动复制未成功，请长按或选中号码 ${value} 复制。`;
      }
      status.textContent = message;
      toast.textContent = message;
      toast.classList.add('is-visible');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('is-visible'), 4000);
    });
  });
</script>

