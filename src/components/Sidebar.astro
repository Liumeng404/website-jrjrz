---
/**
 * 博客详情侧栏
 * 顺序（上→下）：组件3 广告 → 组件2 作者 → 目录
 * 全部随页面滚动，不 sticky
 */
import BlogAuthorCard from './BlogAuthorCard.astro';
import BlogAdCard from './BlogAdCard.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  adProduct?: 'chatgpt' | 'claude' | 'grok';
}

const { headings = [], adProduct = 'chatgpt' } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<aside class="article-aside">
  <!-- 组件3：广告 -->
  <BlogAdCard product={adProduct} />

  <!-- 组件2：作者 -->
  <BlogAuthorCard />

  <!-- 目录 -->
  {toc.length > 0 && (
    <section class="widget widget-toc">
      <h3 class="widget-title">目录</h3>
      <nav class="toc" aria-label="文章目录">
        <ul class="toc-list">
          {toc.map((h) => (
            <li class={`toc-item toc-depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </section>
  )}
</aside>

<script>
  function initTocHighlight() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-list a'));
    if (!links.length) return;

    const idToLink = new Map<string, HTMLAnchorElement>();
    const headings: HTMLElement[] = [];

    links.forEach((link) => {
      const id = decodeURIComponent(link.getAttribute('href')?.slice(1) || '');
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      idToLink.set(id, link);
      headings.push(el);
    });

    if (!headings.length) return;

    const setActive = (id: string) => {
      links.forEach((l) => l.classList.remove('is-active'));
      idToLink.get(id)?.classList.add('is-active');
    };

    const activateByScroll = () => {
      const y = window.scrollY + 130;
      let current = headings[0]?.id;
      for (const h of headings) {
        if (h.offsetTop <= y) current = h.id;
      }
      if (current) setActive(current);
    };
    activateByScroll();
    window.addEventListener('scroll', activateByScroll, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTocHighlight);
  } else {
    initTocHighlight();
  }
</script>
